program QUANTUM_CHRONICLE;

// Standardized Xenograft Shared-Memory ABI Offsets
const ENT_BASE = 64;

// ============================================================================
// STRATUM 0: STEM NUCLEUS (k=2, n=24 — survives 91.7% binary destruction!)
// ============================================================================
bundle S0_STEM_NUCLEUS {
  let f = frame();
  mem[0] = f;
  mem[14] = input();

  let hasLogic = organ_call(LOGIC, 1);
  if (hasLogic == 0) {
    mem[3] = 80;
    mem[4] = 60;
    mem[11] = (f * 1103515245 + 12345) & 0x7fff;
  }

  let drew = organ_call(RENDERER, 2);
  if (drew == 0) {
    clear(0);
    let r = 10 + ((f >> 1) & 15);
    circle(80, 60, r, 4, 0);
    line(64, 60, 96, 60, 4);
    line(80, 44, 80, 76, 4);
    label(4, 4, "S0:Q", "STEM", 4);
    number(124, 4, f, 14);
  }

  organ_call(FX, 3);

  let heard = organ_call(AUDIO, 2);
  if (heard == 0) {
    if ((f % 40) < 4) {
      voice(0, 4, 1760, 22, 0, 900);
    } else {
      voice(0, 0, 0, 0, 0, 900);
    }
  }
}

// ============================================================================
// STRATUM 1: QUANTUM PHASE-WAVE & CHRONO-ENTROPY KERNEL (k=4, n=24)
// Computes live quantum phase angles, Bell correlation seeds, and 12 orbital
// qubit-echo entities inside standardized Shared-Memory ABI RAM!
// ============================================================================
bundle S1_CORE_LOGIC {
  let f = mem[0];
  let inp = mem[14];
  mem[7] = 0;

  if (mem[15] == 0) {
    mem[15] = 1;
    mem[3] = 80;
    mem[4] = 60;
    mem[2] = 100;
    mem[12] = 12;
    mem[11] = 0x2828;
  }

  // Evolve live phase-coherent quantum entropy seed (read by 3D WebGL2 Chrono-Quantum Engine!)
  let phase = (f * 5 + (inp & 31) * 19) % 360;
  let sx = sin(phase);
  let cx = cos(phase);
  mem[3] = 80 + ((sx * 48) >> 8);
  mem[4] = 62 + ((cx * 34) >> 8);
  mem[5] = phase;
  mem[11] = ((mem[11] * 33 + phase + 7) ^ (mem[11] >> 3)) & 0x7fff;
  mem[1] = f * 3 + (mem[11] & 63);

  let i = 0;
  while (i < 12) {
    let base = ENT_BASE + i * 8;
    let a = (f * 3 + i * 30) % 360;
    let rad = 18 + ((sin(a * 2 + f) * 18) >> 8);
    mem[base] = (i % 3) + 1;
    mem[base + 1] = 80 + ((cos(a) * rad) >> 8);
    mem[base + 2] = 62 + ((sin(a) * rad) >> 8);
    mem[base + 6] = a;
    mem[base + 7] = (i & 1) ? 13 : 3;
    i += 1;
  }
}

// ============================================================================
// STRATUM 1: WIREFRAME QUANTUM BLOCH MONITOR (k=4, n=24)
// ============================================================================
bundle S1_WIREFRAME {
  clear(0);
  circle(80, 62, 34, 3, 0);
  line(46, 62, 114, 62, 15);
  line(80, 28, 80, 96, 15);
  line(80, 62, mem[3], mem[4], 2);
  circle(mem[3], mem[4], 3, 4, 0);
  label(4, 2, "S1:Q", "WIRE", 3);
  number(112, 2, mem[1], 2);
}

// ============================================================================
// STRATUM 2: QUANTUM INTERFERENCE & BELL-STATE SCOPE RENDERER (k=8, n=32)
// ============================================================================
bundle S2_CORTEX_RENDER {
  let f = mem[0];
  glow(205);

  let px = mem[3];
  let py = mem[4];
  circle(80, 62, 38, 12, 0);
  circle(px, py, 5, 13, 0);
  line(80, 62, px, py, 3);

  let i = 0;
  while (i < 12) {
    let base = ENT_BASE + i * 8;
    if (mem[base] != 0) {
      let x = mem[base + 1];
      let y = mem[base + 2];
      let nb = ENT_BASE + ((i + 3) % 12) * 8;
      line(x, y, mem[nb + 1], mem[nb + 2], (i & 1) ? 6 : 3);
      circle(x, y, 2, (i & 1) ? 13 : 2, 1);
    }
    i += 1;
  }

  rect(0, 0, 160, 11, 0, 1);
  line(0, 11, 159, 11, 13);
  label(3, 2, "QCHR", "ON3D", 13);
  number(106, 2, mem[11], 3);
}

// ============================================================================
// STRATUM 2: CHRONO-QUANTUM POLYPHONIC SYNTH ORGAN (k=6, n=24)
// ============================================================================
bundle S2_SYNTH_AUDIO {
  let f = mem[0];
  let step = (f >> 4) & 3;
  let root = 1760;
  if (step == 1) { root = 1975; }
  if (step == 2) { root = 2349; }
  if (step == 3) { root = 1568; }
  voice(0, 1, root, 26, 0, 700);
  voice(1, 2, (root * 3) / 2, 18, 6, 2200);
  voice(2, 1, root * 3 + ((mem[3] - 80) * 4), 14, -5, 3400);
  voice(3, 0, 0, 0, 0, 1600);
}

// ============================================================================
// STRATUM 3: FULL CHRONO-HOLOGRAPHIC AURA FX (k=16, n=40)
// ============================================================================
bundle S3_ORGANISM_FX {
  let f = mem[0];
  let r = 20 + ((sin(f * 4) * 14) >> 8);
  circle(80, 62, r, 6, 0);
  label(74, 2, "S3", "", 6);
}
