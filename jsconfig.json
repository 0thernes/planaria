{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "src/**/*.js",
    "bin/**/*.mjs",
    "scripts/**/*.mjs",
    "examples/**/*.mjs",
    "server.mjs"
  ],
  "exclude": [
    "lean",
    "dist",
    "_site"
  ]
}
