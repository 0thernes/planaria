  "files": [
    "bin/",
    "src/",
    "programs/",
    "artifacts/",
    "blueprint/",
    "reference/",
    "results/",
    "examples/",
    "lean/",
    "paper/",
    "docs/",
    "server.mjs",
    "formalization.yaml",
    "LICENSE",
    "LEGAL.md",
    "NOTICE",
    "README.md",
    "SUMMARY.md",
    "VERSION"
